    {
      "dot": "cyan",
      "title": "Understand & Support / 理解项目",
      "items": [
        "Chat and explanation without workflow pollution",
        "Project Entry Scan, remote discovery, re-adoption",
        "Operational Support and Evidence-Graph + DDD Onboarding"
      ]
    },
    {
      "dot": "violet",
      "title": "Shape Product & Design / 产品设计",
      "items": [
        "Brief or Standard Requirement Product Definition",
        "Concept Foundation, roles, flows, states, data, exceptions",
        "Optional visual consensus and Requirement-to-ADR landing"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deliver With The Right Weight / 合适重量",
      "items": [
        "Persistent Lightweight Change card for bounded non-Bug work",
        "Feature Product Slice, tasks, tests, Plan, TDD and Auto-Loop",
        "Bug identity and Feature-owned repair; optional Delivery Contract"
      ]
    },
    {
      "dot": "amber",
      "title": "Maintain Project Truth / 维护事实",
      "items": [
        "Project memory, root guidance and project-local skills",
        "Branch strategy, Feature archive / rehydrate and drift repair",
        "Post-merge memory reconciliation, Submit / Integrate and close"
      ]
    },
    {
      "dot": "rose",
      "title": "Human Control / 人类控制",
      "items": [
        "Agent owns diagnosis, sequencing, implementation and evidence",
        "Human owns goals, product meaning and consequential decisions",
        "Git, production, external, release and close gates stay independent"
      ]
